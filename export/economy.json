  "currency": {
    "id": "coins",
    "name": "Coins",
    "start_cash": 0.0,
    "name_key": "CURRENCY_NAME"
  },
  "formulas": {
    "level_cost": "base_cost * pow(cost_growth, level)   # level = levels already owned",
    "bulk_cost": "base_cost * pow(cost_growth, level) * (pow(cost_growth, n) - 1) / (cost_growth - 1)",
    "max_affordable": "floor(log(cash * (cost_growth - 1) / level_cost(level) + 1) / log(cost_growth)), then step down while bulk_cost > cash (float guard); 0 if cash < level_cost(level)",
    "milestone_mult": "product of mult for every staff_milestones entry with level >= entry.level",
    "staff_income": "level * income * milestone_mult(level)",
    "tier_income": "sum(staff_income) * (1 + sum(value*level of 'income' upgrades)) * (1 + sum(value*level of 'speed' upgrades)) * product(owned manager income_mult)",
    "global_mult": "product(global_income_mult of owned tiers) * (1 + reputation * prestige.bonus_per_point) * product(active event income_mult)",
    "auto_income": "sum(tier_income of owned tiers) * global_mult",
    "tap_value": "(tap.base_value + sum(value*level of 'flat' tap upgrades)) * (1 + sum(value*level of 'pct' tap upgrades)) * tap_mult(highest owned tier) * global_mult + sum(value*level of 'income_share' tap upgrades) * auto_income",
    "offline_income": "sum(tier_income of tiers with an enables_offline manager) * global_mult * offline.efficiency * min(seconds_away, offline_cap_hours * 3600)",
    "offline_cap_hours": "offline.cap_hours + sum(offline_cap_hours_add of owned managers)",
    "amount": "flat + cash_fraction * cash + income_seconds * (auto_income + tap income per second)",
    "reputation_total": "floor(prestige.scale * pow(all_time_earnings / prestige.base_requirement, prestige.exponent))",
    "reputation_gain": "reputation_total - reputation_already_owned (only with prestige.required_tier owned)",
    "event_chance_per_second": "1 - exp(-rate_per_hour / 3600)"
  },
